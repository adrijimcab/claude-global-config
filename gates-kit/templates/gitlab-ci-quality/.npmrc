# Scoped registry: every `@<SCOPE>/*` package resolves from the company registry; unscoped packages still
# come from the public registry. Replace <SCOPE>, <REGISTRY_HOST> and <REGISTRY_PATH>.
# @es Registro con scope: todo paquete `@<SCOPE>/*` se resuelve desde el registro de la empresa; los
# paquetes sin scope siguen viniendo del registro público. Reemplazar <SCOPE>, <REGISTRY_HOST> y
# <REGISTRY_PATH>.
@<SCOPE>:registry=https://<REGISTRY_HOST>/<REGISTRY_PATH>/

# Credential: ONLY an environment reference. npm expands `${REGISTRY_TOKEN}` when it reads this file; the
# value lives in a masked CI/CD variable and in each developer's environment, never in a tracked file.
# @es Credencial: SOLO una referencia de entorno. npm expande `${REGISTRY_TOKEN}` al leer este fichero; el
# valor vive en una variable de CI/CD enmascarada y en el entorno de cada desarrollador, nunca en un
# fichero versionado.
//<REGISTRY_HOST>/:_authToken=${REGISTRY_TOKEN}
